# Backend base URL — required.
EXPO_PUBLIC_API_URL=http://localhost:8080

# Developer mode. When true, the UI exposes a "manual address" wallet
# adapter, raw error messages, and other debug surfaces. KEEP FALSE
# in production builds — real users should never see these.
EXPO_PUBLIC_DEV_MODE=false

# Show raw API / SDK error strings to end users. Implied by DEV_MODE.
# Leave false in production; enable temporarily when triaging a bug.
EXPO_PUBLIC_VERBOSE_ERRORS=false

# Privy wallet — https://dashboard.privy.io
# Create an app + mobile client. Enable email / social / WalletConnect.
# Expo Go allowlist: host.exp.exponent
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# WalletConnect (web fallback / standalone) — https://cloud.walletconnect.com
EXPO_PUBLIC_WALLETCONNECT_PROJECT_ID=
